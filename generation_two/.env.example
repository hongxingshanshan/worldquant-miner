# LLM Configuration for Generation Two
# Copy this file to .env and fill in your values

# Provider type: 'online' or 'ollama' (highest priority, overrides config)
LLM_PROVIDER=online

# API Key for online LLM (required when provider=online)
LLM_API_KEY=your_api_key_here

# Base URL for online LLM API (optional, defaults to https://cmkey.cn)
LLM_BASE_URL=https://cmkey.cn

# Model name for LLM (optional, defaults to glm-5.1 for online, llama3:8b for ollama)
LLM_MODEL=glm-5.1
